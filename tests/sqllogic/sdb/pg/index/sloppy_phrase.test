hash-threshold 100

statement ok
CREATE TABLE sloppy (a INTEGER PRIMARY KEY, b VARCHAR);

statement ok
CREATE TEXT SEARCH DICTIONARY sloppy_english(
    template = 'text',
    locale = 'en_US.UTF-8',
    case = 'lower',
    stemming = false,
    accent = false,
    frequency = true,
    position = true
);

statement ok
CREATE INDEX sloppy_idx ON sloppy USING inverted(a, b sloppy_english);

statement ok
INSERT INTO sloppy values (1, 'quick brown fox');

statement ok
INSERT INTO sloppy values (2, 'quick fox');

statement ok
INSERT INTO sloppy values (3, 'quick red angry fox');

statement ok
INSERT INTO sloppy values (4, 'fox quick');

statement ok
INSERT INTO sloppy values (5, 'slow grey turtle');

statement ok
INSERT INTO sloppy values (6, 'lazy quick fox dog');

statement ok
VACUUM (REFRESH_TABLE) sloppy;

# ----------------------------------------------------------------------
# slop counts position moves: one inserted word
# costs 1, a transposed adjacent pair costs 2.
# ----------------------------------------------------------------------

# slop=0 is an exact phrase.
query
SELECT a FROM sloppy_idx WHERE b @@ ts_sloppy_phrase('quick fox', 0) ORDER BY a;
----
a
2
6

# slop=1 admits one inserted word ('quick brown fox').
query
SELECT a FROM sloppy_idx WHERE b @@ ts_sloppy_phrase('quick fox', 1) ORDER BY a;
----
a
1
2
6

# slop=2 admits two inserted words and the transposed pair 'fox quick'.
query
SELECT a FROM sloppy_idx WHERE b @@ ts_sloppy_phrase('quick fox', 2) ORDER BY a;
----
a
1
2
3
4
6

# ----------------------------------------------------------------------
# slop=0 coincides with ts_phrase.
# ----------------------------------------------------------------------

query
SELECT a FROM sloppy_idx WHERE b @@ ts_phrase('quick fox') ORDER BY a;
----
a
2
6

# ----------------------------------------------------------------------
# ::slop(N) modifier is equivalent to the function form, on both
# phrase constructors.
# ----------------------------------------------------------------------

query
SELECT a FROM sloppy_idx WHERE b @@ ts_phrase('quick fox')::slop(1) ORDER BY a;
----
a
1
2
6

query
SELECT a FROM sloppy_idx WHERE b @@ phraseto_tsquery('quick fox')::slop(1) ORDER BY a;
----
a
1
2
6

# ----------------------------------------------------------------------
# Exact gaps compose with the sloppy form: quick <exactly one word> fox.
# ----------------------------------------------------------------------

query
SELECT a FROM sloppy_idx WHERE b @@ ts_sloppy_phrase('quick', 0, 1, 'fox') ORDER BY a;
----
a
1

# ----------------------------------------------------------------------
# Error paths.
# ----------------------------------------------------------------------

# Negative slop.
statement error
SELECT a FROM sloppy_idx WHERE b @@ ts_sloppy_phrase('quick fox', -1);

# NULL slop folds the predicate to NULL at bind: no rows, no error.
query
SELECT a FROM sloppy_idx WHERE b @@ ts_sloppy_phrase('quick fox', NULL) ORDER BY a;
----
a

# Interval gaps are incompatible with a slop budget.
statement error
SELECT a FROM sloppy_idx WHERE b @@ ts_sloppy_phrase('quick', 2, [1, 3], 'fox');

# ::slop on a non-phrase leaf.
statement error
SELECT a FROM sloppy_idx WHERE b @@ ts_like('quick')::slop(2);

# ::slop applied twice.
statement error
SELECT a FROM sloppy_idx WHERE b @@ ts_phrase('quick fox')::slop(1)::slop(2);

# ::slop on ts_sloppy_phrase (two budgets collide).
statement error
SELECT a FROM sloppy_idx WHERE b @@ ts_sloppy_phrase('quick fox', 1)::slop(2);

# ::slop budget must be >= 0 (rejected at bind by the type binder).
statement error
SELECT a FROM sloppy_idx WHERE b @@ ts_phrase('quick fox')::slop(-2);

# ::slop budget above the position-attribute range.
statement error
SELECT a FROM sloppy_idx WHERE b @@ ts_phrase('quick fox')::slop(5000000000);

# Additional corpus for the multi-term, repeated-term, and gap cases.

statement ok
INSERT INTO sloppy values (7, 'quick brown lazy fox');

statement ok
INSERT INTO sloppy values (8, 'quick red brown red fox');

statement ok
INSERT INTO sloppy values (9, 'quick quick fox');

statement ok
VACUUM (REFRESH_TABLE) sloppy;

# ----------------------------------------------------------------------
# Three terms: one budget shared across all pairs.
# ----------------------------------------------------------------------

query
SELECT a FROM sloppy_idx WHERE b @@ ts_sloppy_phrase('quick brown fox', 0) ORDER BY a;
----
a
1

# One inserted word ('lazy' between brown and fox).
query
SELECT a FROM sloppy_idx WHERE b @@ ts_sloppy_phrase('quick brown fox', 1) ORDER BY a;
----
a
1
7

# Two inserted words, one in each pair.
query
SELECT a FROM sloppy_idx WHERE b @@ ts_sloppy_phrase('quick brown fox', 2) ORDER BY a;
----
a
1
7
8

# ----------------------------------------------------------------------
# Repeated query term: one document occurrence cannot satisfy two
# query slots, so a single 'quick' never matches 'quick quick'.
# ----------------------------------------------------------------------

query
SELECT a FROM sloppy_idx WHERE b @@ ts_sloppy_phrase('quick quick', 0) ORDER BY a;
----
a
9

query
SELECT a FROM sloppy_idx WHERE b @@ ts_sloppy_phrase('quick quick', 2) ORDER BY a;
----
a
9

# ----------------------------------------------------------------------
# Declared gap + slop: the budget counts deviation from the declared
# gap, not from adjacency. 'quick <one word> fox' declares step 2.
# ----------------------------------------------------------------------

query
SELECT a FROM sloppy_idx WHERE b @@ ts_sloppy_phrase('quick', 0, 1, 'fox') ORDER BY a;
----
a
1
9

# Budget 1 admits step 1 (adjacent) and step 3 (two words between).
query
SELECT a FROM sloppy_idx WHERE b @@ ts_sloppy_phrase('quick', 1, 1, 'fox') ORDER BY a;
----
a
1
2
3
6
7
9

# ----------------------------------------------------------------------
# Budget validation: strict integer, no silent rounding.
# ----------------------------------------------------------------------

statement error
SELECT a FROM sloppy_idx WHERE b @@ ts_phrase('quick fox')::slop(1.5);

statement error
SELECT a FROM sloppy_idx WHERE b @@ ts_phrase('quick fox')::slop(NULL);

# Function form above the position-attribute range: same error as the
# ::slop form.
statement error
SELECT a FROM sloppy_idx WHERE b @@ ts_sloppy_phrase('quick fox', 5000000000);

# Fractional gaps error the same way as fractional budgets.
statement error
SELECT a FROM sloppy_idx WHERE b @@ ts_phrase('quick', 1.5, 'fox');

statement error
SELECT a FROM sloppy_idx WHERE b @@ ts_sloppy_phrase('quick', 0, 1.5, 'fox');

query
EXPLAIN SELECT a FROM sloppy_idx WHERE b @@ ts_sloppy_phrase('quick fox', 1);
----
QUERY PLAN
╭─ IRESEARCH_SCAN ───────────────────────╮
│ Index: sloppy_idx                      │
│ Lookup: table                          │
│ Filter:                                │
│ ╭─ Phrase ───────────────────────────╮ │
│ │ Field: b(string)                   │ │
│ │ Parts:                             │ │
│ │ Term:quick(0, 0); Term:fox(1, 1);  │ │
│ │ Slop: 1                            │ │
│ ╰────────────────────────────────────╯ │
│ Projections: a                         │
│ ~1 row                                 │
╰────────────────────────────────────────╯
