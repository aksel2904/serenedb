}

// Readiness marker: bpftrace prints "Attaching" before the uprobes are live,
// and printf to -o is buffered; $1 is the marker file to create.
uprobe:@SERENED@:_ZN6duckdb12_GLOBAL__N_111MD5FunctionERNS_9DataChunkERNS_15ExpressionStateERNS_6VectorE
/@ready == 0/
{
  @ready = 1;
  system("touch %s", str($1));
}

END
{
  clear(@t0);
  clear(@self);
  clear(@flag);
  clear(@ready);
}
